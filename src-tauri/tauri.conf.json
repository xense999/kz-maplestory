{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kz-maplestory",
  "version": "0.1.0",
  "identifier": "com.scorp.kz-maplestory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "久世管理器",
        "width": 1000,
        "height": 540,
        "minWidth": 900,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "float",
        "url": "index.html?view=float",
        "title": "久世管理器 — 浮動計時",
        "width": 232,
        "height": 148,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
